ENVIRONMENT=test
CORS_ORIGINS=http://localhost:3000
# Optional anchored HTTPS preview expression, constrained to your own Vercel project.
CORS_ORIGIN_REGEX=
SITE_URL=http://localhost:3000

# Supabase: publishable key may be used by Auth clients; service-role stays server-only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Recommended modern server key. Keep it only in the backend secret store.
SUPABASE_SECRET_KEY=
# Legacy fallback only.
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=test
# Keep the original receiver's mode when new Checkout changes mode.
STRIPE_LEGACY_WEBHOOK_MODE=test
# Optional pinned account of the HISTORICAL receiver, not the current checkout.
# Required to accept signed snapshots containing Event.context; never infer it
# from metadata, the current key, or a different sandbox. Blank preserves rejection.
STRIPE_LEGACY_ACCOUNT_ID=
# Optional account-bound Checkout. Leave blank until profiles/merchant access
# and commercial offers are configured. Store JSON only as a BACKEND SECRET.
# Schema: [{"reference":"...","mode":"sandbox|production","account_id":"acct_...","signing_secret":"whsec_..."}]
# Each receiver uses /api/stripe/webhook/{reference}; keep historical profiles.
# Use distinct signing secrets, also different from STRIPE_WEBHOOK_SECRET.
STRIPE_WEBHOOK_PROFILES_JSON=
STRIPE_CHECKOUT_PROFILE=
# Drafts can be tried in sandbox without changing publication or real inventory.
# Automatically ignored in live mode. Set false to restore read-only previews.
TEST_CATALOG_ENABLED=true
SHIPPING_COUNTRIES=FR,BE,DE,ES,IT,LU,NL,PT
STRIPE_AUTOMATIC_TAX=false
FREE_SHIPPING_THRESHOLD_CENTS=35000
SHIPPING_RATE_CENTS=1500

# Either use CLOUDINARY_URL or the three separate Cloudinary variables.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email delivery is server-only. Gmail requires 2FA and an app password.
EMAIL_ENABLED=false
# Persisted financial queue: opt-in runtime plus the independent database gate.
# Only new pending atomic receipts are eligible; blocked/unknown require review.
FINANCIAL_NOTIFICATIONS_ENABLED=false
FINANCIAL_NOTIFICATIONS_INTERVAL_SECONDS=30
EMAIL_PROVIDER=brevo
EMAIL_FROM_NAME=TYMotors
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_TOKEN_SECRET=
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# SMTP remains available as a fallback for hosts that allow outbound SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# All legal identity fields stay empty until supplied by the owner.
# Public allow-list /api/site-config and order summary issuer share these values.
LEGAL_COMPANY_NAME=
LEGAL_LEGAL_FORM=
LEGAL_SIRET=
LEGAL_REGISTRATION=
LEGAL_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_CONTACT_PHONE=
LEGAL_VAT_MENTION=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_MEDIATOR_NAME=
LEGAL_MEDIATOR_URL=
LEGAL_MEDIATOR_ADDRESS=
LEGAL_HOSTING_DETAILS=
LEGAL_RETURNS_ADDRESS=

# Optional operator-only diagnostics / backups; not frontend or web runtime secrets.
CHECK_BACKEND_URL=
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=14
BACKUP_TIMEOUT_SECONDS=1800
BACKUP_PG_SCHEMAS=public,auth
PG_DUMP_PATH=pg_dump
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSFILE=
PGPASSWORD=
PGSSLMODE=verify-full
PGSSLROOTCERT=
MONGODUMP_PATH=mongodump
MONGODB_URI=
MONGODB_DATABASE=
