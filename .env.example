ENVIRONMENT=test
CORS_ORIGINS=http://localhost:3000,https://tymotors.vercel.app
CORS_ORIGIN_REGEX=^https://tymotors-[a-z0-9-]+\.vercel\.app$
FRONTEND_URL=https://tymotors.vercel.app

# Supabase: publishable key may be used by Auth clients; service-role stays server-only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Recommended modern server key. Keep it only in the backend secret store.
SUPABASE_SECRET_KEY=
# Legacy fallback only.
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
FREE_SHIPPING_THRESHOLD_CENTS=35000
SHIPPING_RATE_CENTS=1500

# Either use CLOUDINARY_URL or the three separate Cloudinary variables.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email delivery is server-only. Gmail requires 2FA and an app password.
EMAIL_ENABLED=false
EMAIL_PROVIDER=brevo
EMAIL_FROM_NAME=TYMotors
EMAIL_FROM_ADDRESS=tyachatfr@gmail.com
EMAIL_REPLY_TO=tyachatfr@gmail.com
EMAIL_TOKEN_SECRET=
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# SMTP remains available as a fallback for hosts that allow outbound SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tyachatfr@gmail.com
SMTP_PASSWORD=
SMTP_USE_TLS=true
