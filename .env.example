MONGO_URL=mongodb://localhost:27017
DB_NAME=tymotors
ENVIRONMENT=test
CORS_ORIGINS=http://localhost:3000,https://tymotors.vercel.app
CORS_ORIGIN_REGEX=^https://tymotors-[a-z0-9-]+\.vercel\.app$
FRONTEND_URL=http://localhost:3000

# Store only a bcrypt hash for the admin password. Keep the JWT secret server-side.
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
ADMIN_TOKEN_TTL_MINUTES=15

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FREE_SHIPPING_THRESHOLD_CENTS=35000
SHIPPING_RATE_CENTS=1500

# Either use CLOUDINARY_URL or the three separate Cloudinary variables.
CLOUDINARY_URL=
